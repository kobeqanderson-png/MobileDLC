{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mobile-dlc-labeler",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobile-dlc-labeler-db",
      "database_id": "43c7bc88-882e-4930-9dfc-5f1decc75c3f"
    }
  ]
}
